# Copy to .env for local testing (or set these as real environment
# variables / secrets in whatever host you deploy to — Render, Cloud Run,
# Railway, Fly.io, etc.). Never commit a real .env file to git.

GEMINI_API_KEY=your-gemini-api-key-from-aistudio.google.com
